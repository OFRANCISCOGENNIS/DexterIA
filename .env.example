# ---- Backend (apps/api) ----
# Banco: PostgreSQL recomendado (busca full-text). Sem esta variável, usa SQLite em apps/api/data/genisia.db
DATABASE_URL=postgresql://genisia:genisia@localhost:5432/genisia
# Obrigatória em produção (JWT e criptografia de segredos). Em desenvolvimento é gerada em data/.secret_key
GENISIA_SECRET_KEY=
GENISIA_ENV=development
GENISIA_CORS_ORIGINS=http://localhost:3000

# IA (provedor Anthropic). A chave também pode ser cadastrada (cifrada) em Configurações.
ANTHROPIC_API_KEY=
GENISIA_AI_MODEL=claude-opus-5-5
GENISIA_AI_EFFORT=medium
GENISIA_AI_MAX_TOKENS=16000
GENISIA_DEFAULT_PROJECT_BUDGET_USD=2.0
GENISIA_AI_REFUSAL_FALLBACKS=true

# Orquestrador
GENISIA_WORKER_ENABLED=true
GENISIA_WORKER_THREADS=3

# Sandbox: auto | namespace | docker | process (process = sem isolamento, só desenvolvimento)
GENISIA_SANDBOX_BACKEND=auto
GENISIA_SANDBOX_TIMEOUT_SECONDS=120
GENISIA_SANDBOX_MEMORY_MB=1024
# Diretório de execução; todos os ancestrais precisam permitir travessia (o+x)
GENISIA_SANDBOX_DIR=
# Imagem do backend docker (infrastructure/docker/sandbox.Dockerfile)
GENISIA_SANDBOX_IMAGE=genisia-sandbox:latest

# Importação de repositórios
GENISIA_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
GENISIA_MAX_REPO_MB=800
# Diretórios locais que podem ser analisados (separados por ':')
GENISIA_IMPORT_ROOTS=

# Adaptador REA (opcional): caminho da CLI se não estiver no PATH
GENISIA_REA_BIN=

# ---- Frontend (apps/web) ----
GENISIA_API_URL=http://127.0.0.1:8000
